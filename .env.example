# Copy to .env and fill it in. README.md describes each module.

# Modules after the base, separated by ":" (";" on Windows).
COMPOSE_FILE=compose.yaml:modules/qbittorrent.yaml

# --- Base -----------------------------------------------------------------------------------
TZ=Etc/UTC
# The one folder for downloads and media (README.md: folders). Use a disk with room.
DATA_DIR=/srv/data
# The user that owns DATA_DIR: id -u and id -g.
PUID=1000
PGID=1000
# API keys, chosen here so that the services find each other: openssl rand -hex 16 for each.
SONARR_API_KEY=
RADARR_API_KEY=
PROWLARR_API_KEY=
# SONARR_PORT=8989
# RADARR_PORT=7878
# PROWLARR_PORT=9696

# --- qbittorrent ----------------------------------------------------------------------------
# QBITTORRENT_PORT=8080

# --- sabnzbd --------------------------------------------------------------------------------
# SABNZBD_API_KEY=
# SABNZBD_PORT=8085

# --- lidarr ---------------------------------------------------------------------------------
# LIDARR_API_KEY=
# LIDARR_PORT=8686

# --- bazarr, lazylibrarian ------------------------------------------------------------------
# BAZARR_PORT=6767
# LAZYLIBRARIAN_PORT=5299

# --- recyclarr: english or french -----------------------------------------------------------
# RECYCLARR_PROFILES=english
